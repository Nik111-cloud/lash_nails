---
import type { SiteContent } from '../types/site-content';
import { text, href } from '../lib/render';
import LazyImage from './LazyImage.astro';
interface Props { content: SiteContent }
const { content } = Astro.props;
const slides = content.hero_slides;
---
{slides.length > 0 && <section class="hero-carousel" aria-label={text(content, 'hero.aria_label', 'Предложения студии')}>
  <div class="hero-slides">
    {slides.map((slide, index) => <div class:list={['hero-slide', { 'is-active': index === 0 }]} inert={index !== 0} aria-hidden={index !== 0 ? 'true' : undefined}>
      <LazyImage item={slide} class="hero-slide-photo" eager={index === 0} />
      <div class="hero-overlay-content">
        <p class="eyebrow">{slide.eyebrow}</p>
        {index === 0 ? <><h1>{text(content, 'hero_main_title', `Салон красоты «${content.site_settings.brand_name}» в Уфе`)}</h1><p class="hero-offer">{slide.title} {slide.title_secondary}</p></> : <h2>{slide.title}{slide.title_secondary && <><br />{slide.title_secondary}</>}</h2>}
        <p class="lede">{slide.description}{slide.description_secondary && <><br />{slide.description_secondary}</>}</p>
        <div class="hero-actions"><a class="btn btn-primary" href={href(slide.booking_url, content.site_settings.booking_url)}>{slide.cta_label}</a></div>
      </div>
    </div>)}
  </div>
  {slides.length > 1 && <>
    <button class="hero-arrow prev" type="button" aria-label={text(content, 'hero.previous', 'Предыдущее фото')}>‹</button>
    <button class="hero-arrow next" type="button" aria-label={text(content, 'hero.next', 'Следующее фото')}>›</button>
    <div class="hero-dots">{slides.map((_, index) => <button class:list={['hero-dot', { 'is-active': index === 0 }]} type="button" aria-label={text(content, 'hero_slide_template', 'Слайд {number}').replaceAll('{number}', String(index + 1))}></button>)}</div>
  </>}
</section>}

